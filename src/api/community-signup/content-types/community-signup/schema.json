{
  "kind": "collectionType",
  "collectionName": "community_signups",
  "info": {
    "singularName": "community-signup",
    "pluralName": "community-signups",
    "displayName": "Community Signup",
    "description": "Intent-to-join records for the Mighty Networks community. One row per click on a 'Join the Community' CTA (status Clicked), upgraded to Submitted when the visitor gives us their details, then RedirectedToMN on handoff. Identity fields are `private` (never returned by the content API). The raw IP is never stored — only a salted hash, mirroring analytics-session."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-api": {
      "visible": false
    }
  },
  "attributes": {
    "clickId": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 64
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Clicked",
        "Submitted",
        "RedirectedToMN",
        "MemberConfirmed",
        "Duplicate",
        "Spam"
      ],
      "default": "Clicked",
      "required": true
    },
    "email": { "type": "email", "private": true, "maxLength": 254 },
    "firstName": { "type": "string", "private": true, "maxLength": 80 },
    "lastName": { "type": "string", "private": true, "maxLength": 80 },
    "otherNames": { "type": "string", "private": true, "maxLength": 120 },
    "dateOfBirth": { "type": "date", "private": true },
    "phone": { "type": "string", "private": true, "maxLength": 32 },
    "passwordHash": { "type": "string", "private": true, "maxLength": 255 },
    "country": { "type": "string", "maxLength": 80 },
    "residentialAddress": { "type": "text", "private": true },
    "consentTerms": { "type": "boolean", "default": false },
    "consentMarketing": { "type": "boolean", "default": false },
    "consentRecordedAt": { "type": "datetime" },
    "source": { "type": "string", "maxLength": 128 },
    "utmSource": { "type": "string", "maxLength": 128 },
    "utmMedium": { "type": "string", "maxLength": 128 },
    "utmCampaign": { "type": "string", "maxLength": 128 },
    "referrerHost": { "type": "string", "maxLength": 255 },
    "landingPath": { "type": "string", "maxLength": 512 },
    "attempts": { "type": "integer", "default": 1, "min": 0 },
    "clickedAt": { "type": "datetime" },
    "submittedAt": { "type": "datetime" },
    "redirectedAt": { "type": "datetime" },
    "confirmedAt": { "type": "datetime" },
    "ipHash": { "type": "string", "private": true, "maxLength": 64 },
    "userAgent": { "type": "string", "private": true, "maxLength": 512 },
    "deviceType": {
      "type": "enumeration",
      "enum": ["mobile", "tablet", "desktop", "bot", "unknown"],
      "default": "unknown"
    },
    "botScore": { "type": "float", "default": 0 },
    "notes": { "type": "text" },

    "registrantType": {
      "type": "enumeration",
      "enum": ["jobseeker", "employer", "government", "other"],
      "default": "jobseeker",
      "required": true,
      "description": "Andrew: 'everyone must pass, regardless of their status'. Chosen at step 1 — it decides which wizard steps are shown and, more importantly, which data we may lawfully ask for. An employer contact must never be asked for a passport or a TB result."
    },
    "consentSpecialCategory": {
      "type": "boolean",
      "default": false,
      "description": "Explicit, SEPARATE consent for health and police-clearance data. GDPR Article 9(2)(a) requires this to be distinct from general terms acceptance — it is deliberately NOT covered by consentTerms."
    },
    "consentSpecialCategoryAt": { "type": "datetime" },

    "profileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "private": true
    },
    "cvFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"],
      "private": true
    },
    "supportingDocuments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["files", "images"],
      "private": true
    },

    "organisation": {
      "type": "component",
      "repeatable": false,
      "component": "profile.organisation",
      "private": true
    },
    "hiringNeeds": {
      "type": "component",
      "repeatable": true,
      "component": "profile.hiring-need",
      "private": true
    },
    "healthClearances": {
      "type": "component",
      "repeatable": true,
      "component": "profile.health-clearance",
      "private": true
    },
    "diseaseScreenings": {
      "type": "component",
      "repeatable": true,
      "component": "profile.disease-screening",
      "private": true
    },

    "sourceOfName": {
      "type": "enumeration",
      "enum": ["self_selection", "bulk_upload", "staff_entry"],
      "default": "self_selection",
      "description": "Andrew item 11. bulk_upload means a third party supplied this person — duplicates must be flagged for human adjudication, NEVER auto-merged."
    },
    "sourceOfNameDetail": { "type": "string", "maxLength": 200 },

    "profileStep": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 6,
      "description": "Furthest wizard step completed. Step 1 alone is a captured lead."
    },
    "profileCompleteness": { "type": "integer", "default": 0, "min": 0, "max": 100 },
    "resumeToken": { "type": "string", "private": true, "maxLength": 64 },
    "resumeTokenExpiresAt": { "type": "datetime", "private": true },
    "profileUpdatedAt": { "type": "datetime" },
    "syncedToRegistryAt": {
      "type": "datetime",
      "description": "Set when this profile was pushed to the LMIS person registry. Null = not yet synced."
    },
    "syncError": { "type": "text", "private": true },

    "identityDocuments": {
      "type": "component",
      "repeatable": true,
      "component": "profile.identity-document",
      "private": true
    },
    "contactPoints": {
      "type": "component",
      "repeatable": true,
      "component": "profile.contact-point",
      "private": true
    },
    "qualifications": {
      "type": "component",
      "repeatable": true,
      "component": "profile.qualification",
      "private": true
    },
    "workExperiences": {
      "type": "component",
      "repeatable": true,
      "component": "profile.work-experience",
      "private": true
    },
    "languageCompetencies": {
      "type": "component",
      "repeatable": true,
      "component": "profile.language-competency",
      "private": true
    },
    "characterReferences": {
      "type": "component",
      "repeatable": true,
      "component": "profile.character-reference",
      "private": true
    }
  }
}
