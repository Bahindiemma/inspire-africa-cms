{
  "kind": "collectionType",
  "collectionName": "community_signups",
  "info": {
    "singularName": "community-signup",
    "pluralName": "community-signups",
    "displayName": "Community Signup",
    "description": "Intent-to-join records for the Mighty Networks community. One row per click on a 'Join the Community' CTA (status Clicked), upgraded to Submitted when the visitor gives their name and email, Verified once they confirm the email, then RedirectedToMN on handoff. Identity fields are `private` (never returned by the content API). The raw IP is never stored — only a salted hash, mirroring analytics-session."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-api": {
      "visible": false
    }
  },
  "attributes": {
    "clickId": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 64
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Clicked",
        "Submitted",
        "Verified",
        "RedirectedToMN",
        "MemberConfirmed",
        "Duplicate",
        "Spam"
      ],
      "default": "Clicked",
      "required": true
    },

    "registrantType": {
      "type": "enumeration",
      "enum": ["worker", "employer", "government", "education", "development", "other"],
      "default": "worker",
      "required": true,
      "description": "Andrew: 'everyone must pass, regardless of their status'. Asked at signup so every record is attributable to an audience from the first touch. Six-category taxonomy set by the CEO 2026-08; `jobseeker` was retired in favour of `worker` (his correction) and existing rows were migrated."
    },

    "email": { "type": "email", "private": true, "maxLength": 254 },
    "firstName": { "type": "string", "private": true, "maxLength": 80 },
    "lastName": { "type": "string", "private": true, "maxLength": 80 },

    "emailVerified": {
      "type": "boolean",
      "default": false,
      "description": "Nobody reaches the community until this is true."
    },
    "emailVerifiedAt": { "type": "datetime" },
    "verificationTokenHash": {
      "type": "string",
      "private": true,
      "maxLength": 64,
      "description": "SHA-256 of the emailed token. The token itself is never stored — a database leak must not hand an attacker working verification links."
    },
    "verificationSentAt": { "type": "datetime" },
    "verificationExpiresAt": { "type": "datetime" },
    "verificationSendCount": { "type": "integer", "default": 0, "min": 0 },

    "consentTerms": { "type": "boolean", "default": false },
    "consentMarketing": { "type": "boolean", "default": false },
    "consentRecordedAt": { "type": "datetime" },

    "source": { "type": "string", "maxLength": 128 },
    "utmSource": { "type": "string", "maxLength": 128 },
    "utmMedium": { "type": "string", "maxLength": 128 },
    "utmCampaign": { "type": "string", "maxLength": 128 },
    "referrerHost": { "type": "string", "maxLength": 255 },
    "landingPath": { "type": "string", "maxLength": 512 },
    "sourceOfName": {
      "type": "enumeration",
      "enum": ["self_selection", "bulk_upload", "staff_entry"],
      "default": "self_selection",
      "description": "Andrew item 11. bulk_upload means a third party supplied this person — duplicates must be flagged for human adjudication, NEVER auto-merged."
    },
    "sourceOfNameDetail": { "type": "string", "maxLength": 200 },

    "attempts": { "type": "integer", "default": 1, "min": 0 },
    "clickedAt": { "type": "datetime" },
    "submittedAt": { "type": "datetime" },
    "redirectedAt": { "type": "datetime" },
    "confirmedAt": { "type": "datetime" },

    "ipHash": { "type": "string", "private": true, "maxLength": 64 },
    "userAgent": { "type": "string", "private": true, "maxLength": 512 },
    "deviceType": {
      "type": "enumeration",
      "enum": ["mobile", "tablet", "desktop", "bot", "unknown"],
      "default": "unknown"
    },
    "botScore": { "type": "float", "default": 0 },
    "notes": { "type": "text" }
  }
}
