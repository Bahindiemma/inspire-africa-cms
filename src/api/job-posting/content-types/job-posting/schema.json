{
  "kind": "collectionType",
  "collectionName": "job_postings",
  "info": {
    "singularName": "job-posting",
    "pluralName": "job-postings",
    "displayName": "Job Posting",
    "description": "Live international vacancies surfaced to workers and via the public API."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 200 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": {
      "type": "blocks",
      "required": true,
      "description": "Strapi native Blocks (rich-text) editor."
    },
    "destinationCountry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::corridor.corridor",
      "description": "The destination corridor (UK, EU, USA, …). Pick one, or use \"Create a relation\" to add a new destination. A destination must be published before a job that uses it can be published. Destinations are the Corridor list, so a newly published one also appears in the homepage destinations strip."
    },
    "destinationCity": { "type": "string" },
    "sector": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sector.sector",
      "inversedBy": "job_postings",
      "description": "Pick a sector, or use \"Create a relation\" to add a new one."
    },
    "salaryMin": { "type": "decimal" },
    "salaryMax": { "type": "decimal" },
    "salaryCurrency": {
      "type": "enumeration",
      "enum": ["GBP", "EUR", "USD", "CAD", "AUD", "AED", "SAR", "MUR"],
      "default": "GBP"
    },
    "salaryPeriod": {
      "type": "enumeration",
      "enum": ["hour", "month", "year"],
      "default": "year"
    },
    "requirements": { "type": "blocks", "required": true },
    "benefits": { "type": "blocks" },
    "closingDate": { "type": "date", "required": true },
    "status": {
      "type": "enumeration",
      "enum": ["Draft", "Published", "Closed", "Filled"],
      "default": "Draft",
      "required": true
    },
    "applicationLink": { "type": "string" },
    "vacancies": { "type": "integer", "min": 1, "default": 1 },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
