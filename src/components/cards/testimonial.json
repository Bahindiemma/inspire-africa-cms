{
  "collectionName": "components_cards_testimonials",
  "info": { "displayName": "Testimonial", "icon": "quote-right" },
  "options": {},
  "attributes": {
    "quote": { "type": "text", "required": true },
    "name": { "type": "string", "required": true },
    "role": { "type": "string", "required": true },
    "flag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::testimonial-label.testimonial-label",
      "description": "The label on the card (Worker voice, Employer voice, …). Pick one, or use \"Create a relation\" to add a new label."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    },
    "photoAlt": { "type": "string" }
  }
}
