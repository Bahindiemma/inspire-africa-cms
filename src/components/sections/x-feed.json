{
  "collectionName": "components_sections_x_feeds",
  "info": {
    "displayName": "X feed",
    "icon": "message",
    "description": "The latest posts from one X (Twitter) account, with the author's name and photo."
  },
  "options": {},
  "attributes": {
    "xHandle": {
      "type": "string",
      "required": true,
      "default": "andrewpound",
      "regex": "^@?[A-Za-z0-9_]{1,15}$",
      "maxLength": 16
    },
    "authorName": { "type": "string", "required": true, "default": "Andrew Pound", "maxLength": 80 },
    "authorTitle": { "type": "string", "default": "Chief Executive Officer, INSPIRE AFRICA", "maxLength": 120 },
    "authorPhoto": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "authorPhotoAlt": { "type": "string", "maxLength": 200 },
    "authorPhotoCaption": { "type": "string", "maxLength": 200 },
    "eyebrow": { "type": "string", "default": "Straight from the field", "maxLength": 80 },
    "headingLine1": { "type": "string", "required": true, "default": "In his", "maxLength": 60 },
    "headingLine2": { "type": "string", "default": "own words.", "maxLength": 60 },
    "intro": {
      "type": "text",
      "default": "What our CEO is seeing, saying and sharing on X: labour mobility, migration policy and the people building the pathways."
    },
    "disclaimer": { "type": "string", "default": "Posts from Andrew Pound's personal X account.", "maxLength": 200 },
    "followCtaLabel": { "type": "string", "default": "Follow @andrewpound on X", "maxLength": 60 },
    "postCount": { "type": "integer", "default": 4, "min": 3, "max": 4, "required": true },
    "includeReplies": { "type": "boolean", "default": false },
    "includeReposts": { "type": "boolean", "default": false },
    "onlyWithKeywords": { "type": "string", "maxLength": 300 },
    "hiddenPostIds": { "type": "text" },
    "curatedPostUrls": { "type": "text" },
    "whenUnavailable": {
      "type": "enumeration",
      "enum": ["show_author_card", "hide_section"],
      "default": "show_author_card",
      "required": true
    }
  }
}
