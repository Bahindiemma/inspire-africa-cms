{
  "collectionName": "components_profile_health_clearances",
  "info": { "displayName": "Health / police clearance", "icon": "shield-alt", "description": "Andrew item 7. SPECIAL CATEGORY DATA — health is GDPR Article 9, police clearance is Article 10. Only collected with separate explicit consent (community-signup.consentSpecialCategory) and only where a concrete purpose exists." },
  "options": {},
  "attributes": {
    "kind": { "type": "enumeration", "enum": ["health_certificate", "police_clearance"], "required": true },
    "reference": { "type": "string", "maxLength": 120, "private": true },
    "issuingAuthority": { "type": "string", "maxLength": 200 },
    "issuedOn": { "type": "date" },
    "expiresOn": { "type": "date" },
    "testsCovered": { "type": "text", "private": true },
    "documentFile": { "type": "media", "multiple": false, "allowedTypes": ["files", "images"], "private": true },
    "verificationStatus": { "type": "enumeration", "enum": ["self_declared", "submitted", "verified", "rejected", "expired"], "default": "self_declared" }
  }
}
