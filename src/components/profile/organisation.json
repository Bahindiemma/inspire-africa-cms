{
  "collectionName": "components_profile_organisations",
  "info": { "displayName": "Organisation", "icon": "building", "description": "Employer or government registrants. Andrew's 'regardless of their status' — an employer contact and a ministry official are people too, but the data we need from them is not a jobseeker profile." },
  "options": {},
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 200 },
    "kind": { "type": "enumeration", "enum": ["employer", "ministry", "agency", "public_employment_service", "recruiter", "training_provider", "other"] },
    "registrationNumber": { "type": "string", "maxLength": 120 },
    "country": { "type": "string", "maxLength": 80 },
    "sector": { "type": "string", "maxLength": 120 },
    "sizeBand": { "type": "enumeration", "enum": ["1-9", "10-49", "50-249", "250-999", "1000+"] },
    "website": { "type": "string", "maxLength": 255 },
    "contactJobTitle": { "type": "string", "maxLength": 160 },
    "department": { "type": "string", "maxLength": 200 },
    "remit": { "type": "text" },
    "verificationStatus": { "type": "enumeration", "enum": ["self_declared", "submitted", "verified", "rejected", "expired"], "default": "self_declared" }
  }
}
