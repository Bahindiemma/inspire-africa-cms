{
  "collectionName": "components_profile_work_experiences",
  "info": { "displayName": "Work experience", "icon": "briefcase", "description": "Andrew item 5. `responsibilities` is the jobseeker's own words (evidence); `occupationCode` is our ISCO-08 match (interpretation). Both are kept." },
  "options": {},
  "attributes": {
    "employerName": { "type": "string", "required": true, "maxLength": 200 },
    "employerCountry": { "type": "string", "maxLength": 80 },
    "jobTitle": { "type": "string", "required": true, "maxLength": 160 },
    "occupationCode": { "type": "string", "maxLength": 16 },
    "matchSource": { "type": "enumeration", "enum": ["self_selected", "staff_matched", "auto_suggested"] },
    "startedOn": { "type": "date" },
    "endedOn": { "type": "date" },
    "isCurrent": { "type": "boolean", "default": false },
    "responsibilities": { "type": "text" },
    "verificationStatus": { "type": "enumeration", "enum": ["self_declared", "submitted", "verified", "rejected", "expired"], "default": "self_declared" }
  }
}
